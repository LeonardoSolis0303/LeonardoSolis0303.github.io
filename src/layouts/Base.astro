---
import '../styles/global.css';
import '../styles/reading.css';
import Sidebar from '../components/Sidebar.astro';
import ReadingHeader from '../components/ReadingHeader.astro';
import { routes, t } from '../lib/i18n';
import SEO from '../components/SEO.astro';
import { type Lang } from '../lib/i18n';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  variant?: 'dark' | 'light';
  alternateUrl?: string;
  canonical?: string;
  type?: 'website' | 'article';
  image?: string;
  publishedTime?: Date;
  modifiedTime?: Date;
  noindex?: boolean;
  bodyClass?: string;
}

const {
  lang,
  title,
  description,
  variant = 'light',
  alternateUrl,
  canonical,
  type = 'website',
  image,
  publishedTime,
  modifiedTime,
  noindex,
  bodyClass,
} = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#e7e3dc" />

    <SEO
      title={title}
      description={description}
      lang={lang}
      canonical={canonical}
      alternateUrl={alternateUrl}
      type={type}
      image={image}
      publishedTime={publishedTime}
      modifiedTime={modifiedTime}
      noindex={noindex}
    />
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href="#main-content">{lang === 'es' ? 'Saltar al contenido' : 'Skip to content'}</a>
    <div class:list={['app', { 'app--reading': type === 'article' }]}>
      {type === 'article' && <ReadingHeader lang={lang} alternateUrl={alternateUrl} />}
      {type !== 'article' && <Sidebar lang={lang} altUrl={alternateUrl} />}
      <main class="main" id="main-content" tabindex="-1">
        <slot />
        <footer class="site-footer"><div class="site-footer__inner">
          <span>Leonardo Solis</span>
          <a href={routes[lang].contact}>{t(lang).nav.contact}</a>
          <a href="https://github.com/LeonardoSolis0303" rel="me">GitHub</a>
        </div></footer>
      </main>
    </div>
  </body>
</html>
