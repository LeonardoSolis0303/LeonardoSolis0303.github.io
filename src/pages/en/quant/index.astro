---
import Base from '../../../layouts/Base.astro';
import { t } from '../../../lib/i18n';
import { getEntries, entryUrl } from '../../../lib/publications';

const lang = 'en'; const ui=t(lang);
const entries = await getEntries('quant',lang);
---
<Base lang="en" title={ui.quant.title + ' — Leonardo Solis'} description={ui.quant.subtitle}
 canonical="/en/quant/" alternateUrl="/es/quant/">
<header class="page-header"><div class="kicker">quant research</div><h1 class="page-title">{ui.quant.title}</h1><p class="page-subtitle">{ui.quant.subtitle}</p></header>
<div class="page-body">
<p class="section-intro">{ui.quant.intro}</p>
<div class="card-list quant-list">{entries.map((p)=><a href={entryUrl('quant',p)} class="content-card quant-card">
<div class="card-meta"><span>{p.data.period}</span><span>·</span><span>{p.data.organization}</span></div>
<h2>{p.data.title}</h2><p>{p.data.description}</p>
<div class="tag-row">{p.data.stack.map((tag)=><span>{tag}</span>)}</div></a>)}</div>
{entries.length===0 && <p>{ui.common.empty}</p>}
</div>

</Base>
