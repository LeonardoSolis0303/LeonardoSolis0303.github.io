---
import Base from '../../../layouts/Base.astro';
import { t } from '../../../lib/i18n';
import { getEntries, entryUrl, reviewCategory } from '../../../lib/publications';
import { reviewCatClass } from '../../../lib/site';
const lang = 'en'; const ui=t(lang);
const entries = await getEntries('reviews',lang);
---
<Base lang="en" title={ui.reviews.title + ' — Leonardo Solis'} description={ui.reviews.subtitle}
 canonical="/en/reviews/" alternateUrl="/es/resenas/">
<header class="page-header"><h1 class="page-title">{ui.reviews.title}</h1><p class="page-subtitle">{ui.reviews.subtitle}</p></header>
<div class="page-body">
{entries.length >= 6 && new Set(entries.map(p => p.data.category)).size > 1 && <div class="filterbar" data-filter-group hidden>
<button class="filter-btn is-active" data-filter="all">{ui.reviews.all}</button>
{[...new Set(entries.map(p => p.data.category))].map(category => <button class="filter-btn" data-filter={category}>{reviewCategory(category, lang)}</button>)}
</div>}
<div class="card-list review-grid">{entries.map((p) => <a href={entryUrl('reviews',p)} class="content-card review-card" data-filter-item={p.data.category}>
<div><div class="card-meta"><span class:list={['chip',reviewCatClass(p.data.category)]}>{reviewCategory(p.data.category,lang)}</span></div>
<h2>{p.data.title}</h2><div class="review-author">{p.data.author} · {p.data.year}</div><p>{p.data.description}</p></div>
<div class="review-score" aria-label={`${ui.reviews.score}: ${p.data.score}/10`}>{p.data.score}<small>/10</small><span>{ui.reviews.status[p.data.status]}</span></div>
</a>)}</div>
{entries.length===0 && <p class="empty-state">{ui.common.empty}</p>}
</div>
<script src="/filter.js" is:inline></script>
</Base>
