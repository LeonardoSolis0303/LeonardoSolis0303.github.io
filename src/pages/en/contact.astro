---
import Base from '../../layouts/Base.astro';
import { data } from '../../lib/site';
const contact = data.CV.contact;
---
<Base lang="en" title="Contact — Leonardo Solis" description="Profiles and background." alternateUrl="/es/contacto/" canonical="/en/contact/">
  <header class="page-header"><p class="kicker">Contact</p><h1 class="page-title">Contact</h1><p class="page-subtitle">Profiles and background.</p></header>
  <div class="page-body">
    <div class="prose"><ul>
      {contact.email && <li><strong>Email:</strong> <a href={'mailto:' + contact.email}>{contact.email}</a></li>}
      <li><strong>GitHub:</strong> <a href={'https://' + contact.github}>{contact.github}</a></li>
      {contact.linkedin && <li><strong>LinkedIn:</strong> <a href={'https://' + contact.linkedin}>{contact.linkedin}</a></li>}
      <li><strong>Location:</strong> {contact.ciudad}</li>
    </ul></div>
    <a href="/en/cv/" class="btn-outline">View CV</a>
  </div>
</Base>
