---
import Base from '../../layouts/Base.astro';
import { data } from '../../lib/site';
const contact = data.CV.contact;
---
<Base lang="es" title="Contacto — Leonardo Solis" description="Perfiles y trayectoria." alternateUrl="/en/contact/" canonical="/es/contacto/">
  <header class="page-header"><p class="kicker">Contacto</p><h1 class="page-title">Contacto</h1><p class="page-subtitle">Perfiles y trayectoria.</p></header>
  <div class="page-body">
    <div class="prose"><ul>
      {contact.email && <li><strong>Email:</strong> <a href={'mailto:' + contact.email}>{contact.email}</a></li>}
      <li><strong>GitHub:</strong> <a href={'https://' + contact.github}>{contact.github}</a></li>
      {contact.linkedin && <li><strong>LinkedIn:</strong> <a href={'https://' + contact.linkedin}>{contact.linkedin}</a></li>}
      <li><strong>Ciudad:</strong> {contact.ciudad}</li>
    </ul></div>
    <a href="/es/cv/" class="btn-outline">Ver CV</a>
  </div>
</Base>
