---
import Base from '../../../layouts/Base.astro';
import { t } from '../../../lib/i18n';
import { getEntries, entryUrl } from '../../../lib/publications';

const lang = 'es'; const ui=t(lang);
const entries = await getEntries('teaching',lang);
---
<Base lang="es" title={ui.teaching.title + ' — Leonardo Solis'} description={ui.teaching.subtitle}
 canonical="/es/ensenanza/" alternateUrl="/en/teaching/">
<header class="page-header"><div class="kicker">teaching</div><h1 class="page-title">{ui.teaching.title}</h1><p class="page-subtitle">{ui.teaching.subtitle}</p></header>
<div class="page-body">
<div class="anchor-tabs">
<a href="#problemas">{ui.teaching.problems}</a><a href="#presenciales">{ui.teaching.presential}</a><a href="#universitarias">{ui.teaching.university}</a></div>
{[{id:'problemas',title:ui.teaching.problems},{id:'presenciales',title:ui.teaching.presential},{id:'universitarias',title:ui.teaching.university}].map((group)=>
<section id={group.id} class="content-section">
<div class="section-label"><span class="section-label__text">{group.title}</span><span class="section-label__rule"></span></div>
<div class="card-list">{entries.filter((p)=>p.data.kind===group.id).map((p)=><a href={entryUrl('teaching',p)} class="content-card">
<div class="card-meta"><span>{p.data.year || p.data.period}</span>{p.data.category && <><span>·</span><span>{p.data.category}</span></>}</div>
<h2>{p.data.title}</h2><p>{p.data.description}</p><div class="tag-row">{p.data.tags.map((tag)=><span>{tag}</span>)}</div>
</a>)}</div></section>)}
{entries.length===0 && <p>{ui.common.empty}</p>}
</div>

</Base>
