---
import EntryDetail from '../../../components/EntryDetail.astro';
import { getEntries } from '../../../lib/publications';

export async function getStaticPaths() {
  return (await getEntries('teaching', 'es')).map((entry) => ({
    params: { slug: entry.data.slug }, props: { entry },
  }));
}
const { entry } = Astro.props;
---
<EntryDetail section="teaching" entry={entry} />
