---
import type { Lang } from '../lib/i18n';
import { t } from '../lib/i18n';
import { data, g, arr } from '../lib/site';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const ui = t(lang);
const cv: any = data.CV;
const cvSkills = Object.entries(lang === 'en' ? cv.skills_en : cv.skills).map(([name, values]: any) => ({ name, values }));
const title = g(cv, 'title', lang);
const tagline = g(cv, 'tagline', lang);
const downloadLabel = ui.cv.download;
const cityLabel = lang === 'en' ? 'city' : 'ciudad';
const contactEntries = [
  { key: 'email', label: 'email', value: cv.contact?.email, href: cv.contact?.email ? `mailto:${cv.contact.email}` : null },
  { key: 'github', label: 'github', value: cv.contact?.github, href: cv.contact?.github ? `https://${cv.contact.github.replace(/^https?:\/\//, '')}` : null },
  { key: 'linkedin', label: 'linkedin', value: cv.contact?.linkedin, href: cv.contact?.linkedin ? `https://${cv.contact.linkedin.replace(/^https?:\/\//, '')}` : null },
  { key: 'ciudad', label: cityLabel, value: cv.contact?.ciudad, href: null },
].filter((x) => x.value);
---

<article class="cv2" aria-labelledby="cv-title">
  <header class="cv2__header">
    <div class="cv2__identity">
      <p class="cv2__tagline">{tagline}</p>
      <h1 id="cv-title" class="cv2__name">Leonardo <span>Solis</span></h1>
      <div class="cv2__roleline">
        <p>{title}</p>
        <i aria-hidden="true"></i>
        <p class="cv2__affiliation">UNAM · Fac. Ciencias · 2022</p>
      </div>
    </div>

    <div class="cv2__contact" aria-label={lang === 'en' ? 'Contact information' : 'Información de contacto'}>
      {contactEntries.map((item) => (
        <div class="cv2__contact-item">
          <span>{item.label}</span>
          {item.href ? <a href={item.href} target={item.key === 'email' ? undefined : '_blank'} rel={item.key === 'email' ? undefined : 'noreferrer'}>{item.value}</a> : <strong>{item.value}</strong>}
        </div>
      ))}
    </div>
  </header>

  <div class="cv2__body">

    <div class="cv2__column cv2__column--main">
      <section class="cv2__section">
        <div class="cv2__section-title"><h2>{ui.cv.education}</h2><div aria-hidden="true"></div></div>
        {cv.education.map((item) => (
          <div class="cv2__entry">
            <p class="cv2__period">{item.period}</p>
            <h3>{g(item, 'degree', lang)}</h3>
            <p class="cv2__institution">{item.institution}</p>
            {g(item, 'note', lang) && <p class="cv2__muted cv2__italic">{g(item, 'note', lang)}</p>}
          </div>
        ))}
      </section>

      <section class="cv2__section">
        <div class="cv2__section-title"><h2>{ui.cv.experience}</h2><div aria-hidden="true"></div></div>
        {cv.experience.map((item) => (
          <div class="cv2__entry">
            <p class="cv2__period">{item.period}</p>
            <h3>{g(item, 'role', lang)}</h3>
            <p class="cv2__institution">{item.org}</p>
            <ul>
              {arr(item, 'bullets', lang).map((bullet) => <li><span aria-hidden="true">–</span>{bullet}</li>)}
            </ul>
          </div>
        ))}
      </section>

      <section class="cv2__section">
        <div class="cv2__section-title"><h2>{ui.cv.papers}</h2><div aria-hidden="true"></div></div>
        <div class="cv2__progress-list">
          {cv.papers.map((paper) => (
            <div class="cv2__progress-item">
              <h3>{g(paper, 'titulo', lang)}</h3>
              {g(paper, 'coautores', lang) && <p class="cv2__muted cv2__italic">{g(paper, 'coautores', lang)}</p>}
              <p class="cv2__progress-status">{g(paper, 'estado', lang)}</p>
              <p>{g(paper, 'desc', lang)}</p>
            </div>
          ))}
        </div>
      </section>
    </div>

    <div class="cv2__secondary">
    <section class="cv2__column cv2__column--awards" aria-labelledby="cv-awards-title">
      <div class="cv2__section-title"><h2 id="cv-awards-title">{ui.cv.awards}</h2><div aria-hidden="true"></div></div>
      <div class="cv2__receipt-list">
        {cv.awards.map((award, index) => (
          <div class:list={['cv2__receipt-row', { 'cv2__receipt-row--recent': index < 2 }]}>
            <span>{award.year}</span>
            <div>
              <strong>{g(award, 'title', lang)}</strong>
              <em>{award.org}</em>
            </div>
            {index < 2 && <b aria-hidden="true"></b>}
          </div>
        ))}
      </div>
    </section>

    <aside class="cv2__skills" aria-labelledby="cv-skills-title">
      <h2 id="cv-skills-title">{ui.cv.skills}</h2>
      {cvSkills.map((group) => (
        <div class="cv2__skill-group">
          <h3>{group.name}</h3>
          <div>
            {group.values.map((skill) => <span>{skill}</span>)}
          </div>
        </div>
      ))}
      {cv.pdfUrl && <a class="cv2__download" href={cv.pdfUrl} download>{downloadLabel}</a>}
    </aside>
    </div>
  </div>
</article>

<style>
  .cv2 { max-width: 1100px; margin: 0 auto; padding: 48px clamp(24px, 4vw, 64px) 60px; }
  .cv2__header { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 28px; border-bottom: 1px solid var(--rule); padding-bottom: 32px; }
  .cv2__tagline { font: 600 13px/1.5 var(--font-ui); color: var(--moss); letter-spacing: .06em; margin-bottom: 16px; }
  .cv2__name { font: 500 clamp(40px, 4.3vw, 56px)/1.05 var(--font-serif); letter-spacing: -.02em; }
  .cv2__name span { font-style: italic; font-weight: 400; }
  .cv2__roleline { display: flex; flex-direction: column; gap: 4px; margin-top: 14px; font: 17px/1.5 var(--font-ui); color: var(--moss-deep); }
  .cv2__roleline i { display: none; }
  .cv2__affiliation { color: var(--dim); font-size: 15px; }
  .cv2__contact { align-self: end; font: 15px/1.5 var(--font-ui); display: grid; gap: 10px; }
  .cv2__contact-item span { display: block; color: var(--dim); font-size: 13px; text-transform: capitalize; }
  .cv2__contact-item a { color: var(--moss-deep); overflow-wrap: anywhere; }
  .cv2__contact-item strong { font-weight: 400; }
  .cv2__contact-item a:hover { text-decoration: underline; text-underline-offset: 4px; }
  .cv2__body { display: grid; grid-template-columns: minmax(0,1.4fr) minmax(0,1fr); gap: 42px; margin-top: 34px; }
  .cv2__column--main, .cv2__secondary { display: flex; flex-direction: column; gap: 36px; min-width: 0; }
  .cv2__secondary { padding-left: 30px; border-left: 1px solid var(--rule); }
  .cv2__section-title { margin-bottom: 20px; }
  .cv2__section-title h2, .cv2__skills h2 { font: 500 28px/1.2 var(--font-serif); color: var(--moss-deep); }
  .cv2__entry { margin-bottom: 26px; }
  .cv2__entry:last-child { margin-bottom: 0; }
  .cv2__period { font: 14px/1.5 var(--font-ui); color: var(--dim); margin-bottom: 7px; }
  .cv2__entry h3, .cv2__progress-item h3 { font: 500 23px/1.25 var(--font-serif); margin-bottom: 6px; }
  .cv2__institution { font: 15px/1.5 var(--font-ui); color: var(--moss-deep); margin-bottom: 10px; }
  .cv2__muted { color: var(--dim); font-size: 15px; }
  .cv2__entry ul { margin-top: 12px; }
  .cv2__entry li { display: flex; gap: 9px; font-size: 16px; line-height: 1.65; margin-bottom: 8px; color: var(--ink-soft); }
  .cv2__entry li span { color: var(--moss); }
  .cv2__progress-list { display: grid; gap: 22px; }
  .cv2__progress-item p { font-size: 16px; line-height: 1.65; color: var(--dim); }
  .cv2__progress-item .cv2__progress-status { display: inline-block; margin: 9px 0; padding: 3px 8px; font: 13px/1.5 var(--font-ui); border: 1px solid var(--rule); color: var(--moss-deep); }
  .cv2__receipt-row { display: grid; grid-template-columns: 38px minmax(0,1fr); gap: 12px; padding: 16px 0; border-bottom: 1px solid var(--rule); }
  .cv2__receipt-row:first-child { padding-top: 0; }
  .cv2__receipt-row > span { color: var(--moss); font: 14px/1.6 var(--font-ui); }
  .cv2__receipt-row strong { display: block; font: 500 20px/1.3 var(--font-serif); }
  .cv2__receipt-row em { display: block; font: normal 14px/1.5 var(--font-ui); color: var(--dim); margin-top: 5px; }
  .cv2__receipt-row b { display: none; }
  .cv2__skills { display: grid; gap: 18px; }
  .cv2__skill-group h3 { font: 600 15px/1.5 var(--font-ui); margin-bottom: 8px; }
  .cv2__skill-group > div { display: flex; flex-wrap: wrap; gap: 5px 7px; }
  .cv2__skill-group span { font: 14px/1.5 var(--font-ui); padding: 3px 8px; border: 1px solid var(--rule); border-radius: 3px; color: var(--dim); }
  .cv2__download { font: 15px/1.5 var(--font-ui); color: var(--moss-deep); border: 1px solid var(--rule-strong); padding: 12px 16px; text-align: center; }
  @media (max-width: 1100px) { .cv2__header { grid-template-columns: 1fr; } .cv2__contact { display: flex; flex-wrap: wrap; gap: 16px 28px; } .cv2__body { gap: 26px; } .cv2__secondary { padding-left: 22px; } }
  @media (max-width: 980px) { .cv2__body { grid-template-columns: 1fr; gap: 36px; } .cv2__secondary { padding-left: 0; border-left: 0; } }
  @media (max-width: 720px) { .cv2 { padding: 34px 22px 44px; } }
  @media print { .cv2 { padding: 0; max-width: none; } .cv2__body { grid-template-columns: 1.4fr 1fr; } .cv2__entry, .cv2__receipt-row, .cv2__skill-group { break-inside: avoid; } }
</style>
