---
import Base from '../layouts/Base.astro';
import { t, routes, formatDate, type Lang } from '../lib/i18n';
import { catClass } from '../lib/site';
import { getPosts, postUrl, readingMinutes } from '../lib/blog';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const ui = t(lang);
const posts = await getPosts(lang);
const otherLang = lang === 'es' ? 'en' : 'es';
const cats = ['fisica', 'quant', 'matematicas', 'mercados', 'personal'] as const;
---

<Base lang={lang} title={ui.blog.title + ' — Leonardo Solis'} description={ui.blog.subtitle}
  canonical={routes[lang].blog} alternateUrl={routes[otherLang].blog}>
  <header class="page-header">
    <div class="kicker">{ui.blog.title}</div>
    <h1 class="page-title">{ui.blog.title}</h1>
    <p class="page-subtitle">{ui.blog.subtitle}</p>
  </header>
  <div class="page-body">
    <div class="filterbar" data-filter-group>
      <button class="filter-btn is-active" data-filter="all">{ui.blog.all}</button>
      {cats.map((category) => <button class="filter-btn" data-filter={category}>{ui.blog.cats[category]}</button>)}
    </div>
    <div class="entry-list">
      {posts.map((post) => (
        <a href={postUrl(post)} class:list={['entry', { 'entry--with-image': post.data.image }]} data-filter-item={post.data.category}>
          <div class="entry__date"><time datetime={post.data.date.toISOString().slice(0, 10)}>{formatDate(post.data.date, lang)}</time><span>{readingMinutes(post)} {ui.blog.readingTime}</span></div>
          <div>
            <div class="entry__meta">
              <span class:list={['chip', catClass(post.data.category)]}>{ui.blog.cats[post.data.category]}</span>
              {post.data.featured && <span class="featured-star">★ {ui.blog.featured}</span>}
              {post.data.draft && <span>{lang === 'es' ? 'Borrador' : 'Draft'}</span>}
            </div>
            <h2 class="entry__title">{post.data.title}</h2>
            <p class="entry__excerpt">{post.data.description}</p>
          </div>
          {post.data.image && <img src={post.data.image} alt={post.data.imageAlt} class="entry__cover" loading="lazy" />}
        </a>
      ))}
    </div>
    {posts.length === 0 && <p>{ui.common.empty}</p>}
  </div>
  <script src="/filter.js" is:inline></script>
</Base>
